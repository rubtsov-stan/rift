{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -u -m http.server 8080 --directory site/public-lighthouse",
      "startServerReadyPattern": "Serving HTTP",
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/guide/memory/",
        "http://localhost:8080/guide/mcp/",
        "http://localhost:8080/roadmap/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "site/.lighthouseci-reports"
    }
  }
}
