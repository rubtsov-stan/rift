{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defs.json",
  "title": "Shared definitions of the Rift protocol",
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "line": {
      "description": "1-based line number",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "session": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "range": {
      "description": "Lines start to start + count - 1; count 0 sits before line start",
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/line"
        },
        "count": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "start",
        "count"
      ],
      "additionalProperties": false
    },
    "page_params": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/$defs/session"
        },
        "offset": {
          "$ref": "#/$defs/count"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false
    },
    "session_params": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/$defs/session"
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false
    },
    "tally": {
      "type": "object",
      "properties": {
        "segments": {
          "$ref": "#/$defs/count"
        },
        "a_lines": {
          "$ref": "#/$defs/count"
        },
        "b_lines": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "segments",
        "a_lines",
        "b_lines"
      ],
      "additionalProperties": false
    },
    "file_size": {
      "type": "object",
      "properties": {
        "lines": {
          "$ref": "#/$defs/count"
        },
        "bytes": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "lines",
        "bytes"
      ],
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "properties": {
        "phase": {
          "enum": [
            "scan",
            "refine"
          ]
        },
        "done": {
          "$ref": "#/$defs/count"
        },
        "total": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "phase",
        "done",
        "total"
      ],
      "additionalProperties": false,
      "description": "phase scan: bytes read of twice both file sizes; phase refine: segments refined of those that need it"
    },
    "moves_state": {
      "enum": [
        "found",
        "off",
        "skipped"
      ]
    },
    "differing_status": {
      "enum": [
        "differs",
        "approx"
      ]
    },
    "block": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/range"
        },
        "b": {
          "$ref": "#/$defs/range"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "additionalProperties": false
    },
    "text_line": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "bytes": {
          "$ref": "#/$defs/count"
        },
        "eol": {
          "enum": [
            "lf",
            "crlf",
            "none"
          ]
        },
        "truncated": {
          "const": true
        },
        "lossy": {
          "const": true
        },
        "moved": {
          "const": true
        }
      },
      "required": [
        "text",
        "bytes",
        "eol"
      ],
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/line"
        },
        "total": {
          "$ref": "#/$defs/count"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text_line"
          }
        }
      },
      "required": [
        "start",
        "total",
        "lines"
      ],
      "additionalProperties": false
    }
  }
}
