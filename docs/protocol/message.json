{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "message.json",
  "title": "one JSON-RPC message of the protocol",
  "oneOf": [
    {
      "description": "request",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "method": {
          "type": "string"
        },
        "params": {}
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "additionalProperties": false
    },
    {
      "description": "notification",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "type": "string"
        },
        "params": {}
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "additionalProperties": false
    },
    {
      "description": "result",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "result": {}
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "description": "error",
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "error": {
          "$ref": "error.json"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
