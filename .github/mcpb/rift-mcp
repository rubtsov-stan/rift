#!/bin/sh
# Starts the rift-mcp binary for this OS and CPU.
d=$(dirname "$0")
case $(uname -s)-$(uname -m) in
  Darwin-*) exec "$d/rift-mcp-darwin" "$@" ;;
  Linux-x86_64) exec "$d/rift-mcp-linux-x86_64" "$@" ;;
  Linux-aarch64 | Linux-arm64) exec "$d/rift-mcp-linux-aarch64" "$@" ;;
  *) echo "rift-mcp: no binary for $(uname -s) $(uname -m)" >&2; exit 1 ;;
esac
